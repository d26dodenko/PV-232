{
  "name": "clothify-lab3",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "start:back": "node back/server.js",
    "start:front": "vite --config front/vite.config.js --host 127.0.0.1",
    "preview": "vite preview --config front/vite.config.js --host 127.0.0.1 --port 4173 --strictPort",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration --coverage",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run lint && npm run build && npm run test:integration && npm run test:e2e",
    "build": "vite build --config front/vite.config.js",
    "security": "node scripts/security.js",
    "demo:unit": "node scripts/demo.js unit",
    "demo:coverage": "node scripts/demo.js coverage",
    "demo:security": "node scripts/demo.js security",
    "demo:e2e": "node scripts/demo.js e2e",
    "security:python": "bash scripts/python-security.sh",
    "check": "npm test && npm run security && python3 scripts/check_coverage.py coverage/unit/coverage-summary.json coverage/integration/coverage-summary.json"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "supertest": "^7.3.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
